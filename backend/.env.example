# GymVision AI - Backend environment template
#
# Copy to .env and fill in real values. Never commit .env.
# Secrets are read from the environment only, per
# docs/09_security/47_SECURITY_ARCHITECTURE.md section 11.
#
# The backend starts in development with every secret below left blank.
# Features depending on a missing secret are unavailable, and /health reports
# which ones are absent. Production refuses to start unless all are set.

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
JSON_LOGS=false

# Comma-separated. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:5173

# --- Google OAuth ----------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database --------------------------------------------------------------
# postgresql+asyncpg://user:password@host:5432/gymvision
DATABASE_URL=

# --- AI provider -----------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=

# Model and generation settings. Defaults are sensible; override to tune.
# The default is a Groq reasoning model: reasoning and answer share the token
# budget below, so keep AI_MAX_TOKENS generous if you raise the reasoning effort.
AI_MODEL=openai/gpt-oss-120b
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=800
AI_TIMEOUT_SECONDS=20

# --- Tokens ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
